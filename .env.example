# ─────────────────────────────────────────────────────────────
# 병의원 세무·마케팅 자동화 파이프라인 환경변수
#
#   cp .env.example .env   해서 값을 채운다.
#   .env 는 .gitignore 로 막혀 있어 커밋되지 않는다. 절대 풀지 말 것.
#   CI 에서는 저장소 Settings → Secrets and variables → Actions 에 같은 이름으로 등록한다.
# ─────────────────────────────────────────────────────────────

# ── LLM ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-apixx-xxxxxxxxxxxxxxxx

# ── Notion ───────────────────────────────────────────────────
# 통합 토큰: https://www.notion.so/my-integrations
# 만든 뒤 대상 DB 우측 상단 ··· → 연결 → 그 통합을 추가해야 조회된다.
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxx
# DB URL 의 32자리 해시 (notion.so/workspace/<이부분>?v=...)
NOTION_DATABASE_ID=00000000000000000000000000000000

# ── 모델 (비워 두면 아래 기본값) ──────────────────────────────
# 판독·구조화·작성 모두 이 모델로 돈다.
# 품질을 올리려면 claude-opus-5 (요금도 오른다).
ANTHROPIC_MODEL=claude-sonnet-5

# ── 동작 ─────────────────────────────────────────────────────
# 상태 속성 이름과 값 — Notion DB 의 select/status 옵션과 정확히 같아야 한다
NOTION_STATUS_PROPERTY=상태
NOTION_STATUS_PENDING=대기
NOTION_STATUS_RUNNING=처리중
NOTION_STATUS_DONE=완료
NOTION_STATUS_ERROR=오류

# 한 번 실행에서 처리할 최대 건수 (API 비용 폭주 방지)
MAX_PAGES_PER_RUN=5
# 1 로 두면 Notion 만 읽고 LLM 호출·쓰기를 하지 않는다
DRY_RUN=

# ── 원고 말미 상담 연락처 ────────────────────────────────────
# 모델이 전화번호를 지어내지 않도록 여기서 넣는다.
# 비워 두면 원고에 "(연락처 미설정 …)" 자리만 남고 사람이 채운다.
CONTACT_KAKAO=
CONTACT_PHONE=

# 생성된 원고의 분류 — medical(병의원) | transfer(양도)
BLOG_CATEGORY=medical
